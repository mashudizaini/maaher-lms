POSTGRES_DB=maaher
POSTGRES_USER=maaher
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
NEXT_PUBLIC_APP_NAME=Maaher LMS
APP_ENV=local
# Separate credentials: migration owner, restricted API role, and mail-only role.
# Set real URLs and secrets locally; never commit them.
MIGRATION_DATABASE_URL=
DATABASE_URL=
AUTH_DATABASE_URL=
MAIL_DATABASE_URL=
MFA_OPERATOR_DATABASE_URL=
MAINTENANCE_DATABASE_URL=
APP_ORIGIN=http://127.0.0.1:3000
API_BASE_URL=http://127.0.0.1:8000
# Generate with cryptography.fernet.Fernet.generate_key(); keep a backed-up secret.
AUTH_ENCRYPTION_KEY=
# Keyring JSON example: {"v2":"NEW_FERNET_KEY","legacy":"OLD_FERNET_KEY"}
# Keep old keys until every encrypted column has been rotated and verified.
AUTH_ENCRYPTION_KEYS=
AUTH_ACTIVE_KEY_ID=legacy
# Independent secrets. The trusted edge must overwrite client identity headers.
BFF_API_SECRET=
EDGE_SHARED_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set true only with APP_ENV=local for explicit HTTP development.
LOCAL_INSECURE_COOKIES=false
# Optional Auth0 development staff login. Use canonical domain without scheme/path.
# No client secret is exposed to Next.js/browser; API only. Keep real values local.
AUTH0_DOMAIN=dev-hl2un81cojtbhbv4.us.auth0.com
AUTH0_CLIENT_ID=FjD4enWFIU9PNdnLjGwc1M1x4p8xsdW3
AUTH0_CLIENT_SECRET=
# Default: fido2. dev-totp requires APP_ENV=local, loopback origin and an actual
# maaher_test_* database. Never use dev-totp with real users or production.
AUTH0_ASSURANCE_PROFILE=fido2
# Temporary fixed-code diagnostics on API logs; only local + loopback, default off.
# No callback, exception text, token, cookie, user identity or secret is logged.
AUTH0_LOCAL_DIAGNOSTICS=false
