+# Disposable validation image, no host mounts or Docker socket.
+FROM python:3.12-slim
+WORKDIR /app
+ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
+COPY requirements-dev.lock ./
+RUN pip install --no-cache-dir -r requirements-dev.lock && useradd --create-home tester
+COPY app ./app
+COPY migrations ./migrations
+COPY tests ./tests
+COPY alembic.ini pytest.ini ./
+USER tester
+CMD ["python", "-m", "pytest", "-q", "-ra", "--tb=short", "tests"]
