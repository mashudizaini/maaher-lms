+        parser.validate('Same content','tenant-A:user-A')
+        parser.validate('Same content','tenant-B:user-A')
+        parser.validate('Same content','tenant-A:user-B')
+        assert len(seen)==3 and len(parser.cache)==3
+    finally:parser.close()
