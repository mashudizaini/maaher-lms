@@ -0,0 +1,25 @@
+# LMS-01-OIDC — Auth0 staff login, tahap 1
+
+Disetujui pemilik pada 10 November 2026: gunakan Auth0/OpenID Connect dan
+lanjutkan implementasi. Tenant/aplikasi Auth0 belum dibuat; sertakan setup guide.
+
+Lingkup: Authorization Code + PKCE/state/nonce menggunakan Authlib; state
+terenkripsi server-side; binding `(issuer, subject)` yang diprovisi offline;
+session opak staff dengan assurance security key; validasi membership/RLS tetap
+berlaku. Operator ditandai dalam binding privat tetapi tidak diberi API global
+atau kemampuan menyetujui recovery user lain pada tahap ini. Tidak auto-link email.
+
+File: API oidc/provisioning, migrasi 0004, resolver session dan guard local auth,
+BFF/UI login, dependencies/Compose/env example, Action Auth0, tes dan dokumentasi.
+
+Acceptance: callback sekali pakai terikat browser dan config, PKCE S256,
+RS256/JWKS issuer tetap, audience/nonce/auth_time/assurance diverifikasi; subject
+asing dengan email sama ditolak; revoke binding/user/membership menghentikan
+akses; akun staff yang sudah diikat tidak fallback ke password/TOTP/reset lokal.
+Tidak ada token IdP disimpan pada browser/session aplikasi atau audit.
+
+Tes: provider HTTPS sintetis lewat HTTP transport Authlib, token RSA bertanda
+tangan, negative claims/replay/state/browser/config, SQL privilege/RLS dan
+migrasi roundtrip pada DB baru; regresi lokal/browser/build yang relevan.
+Live Auth0 dan security key asli menunggu setup pemilik. Tahap ini bukan klaim
+seluruh H1 selesai atau operator approval/recovery produksi sudah aktif.
diff --git a/infra/auth0/staff-post-login.cjs b/infra/auth0/staff-post-login.cjs
new file mode 100644
--- /dev/null
+++ b/infra/auth0/staff-post-login.cjs
@@ -0,0 +1,21 @@
+// Auth0 Post Login Action. Configure MAAHER_CLIENT_ID as an Action secret.
+// Requires Guardian WebAuthn roaming user_verification=required and supervised
+// key enrollment before approving/binding the staff identity. No auto-enrollment.
+exports.onExecutePostLogin = async (event, api) => {
+  const client = event.secrets?.MAAHER_CLIENT_ID;
+  if (!client) {
+    api.access.deny('Staff login policy is not configured');
+    return;
+  }
+  if (event.client?.client_id !== client) return;
+  if (event.user?.app_metadata?.maaher_staff_approved !== true
+      || !event.user?.enrolledFactors?.some(factor => factor.type === 'webauthn-roaming')) {
+    api.access.deny('Verified staff enrollment is required');
+    return;
+  }
+  // Auth0 does not issue the ID token unless this challenge is fulfilled.
+  // There are deliberately no optional/fallback factors. See official
+  // @auth0/actions post-login/v3 AuthenticationAPI.challengeWith contract.
+  api.authentication.challengeWith({ type: 'webauthn-roaming' });
+  api.idToken.setCustomClaim('https://maaherlms.aimz.my.id/assurance', 'maaher-fido2-uv-v1');
+};
diff --git a/infra/auth0/staff-post-login.test.cjs b/infra/auth0/staff-post-login.test.cjs
new file mode 100644
--- /dev/null
+++ b/infra/auth0/staff-post-login.test.cjs
@@ -0,0 +1,52 @@
+const { test } = require('node:test');
+const assert = require('node:assert/strict');
+const { onExecutePostLogin } = require('./staff-post-login.cjs');
+
+function input() {
+  const calls = [];
+  return {
+    event: { secrets: { MAAHER_CLIENT_ID: 'staff-client' }, client: { client_id: 'staff-client' },
+      user: { app_metadata: { maaher_staff_approved: true }, enrolledFactors: [{ type: 'webauthn-roaming' }] } },
+    api: { access: { deny: reason => calls.push(['deny', reason]) },
+      authentication: { challengeWith: factor => calls.push(['challenge', factor]) },
+      idToken: { setCustomClaim: (key, value) => calls.push(['claim', key, value]) } }, calls,
+  };
+}
+
+test('approved staff must complete the exact security-key challenge; no fallback is supplied', async () => {
+  const { event, api, calls } = input(); await onExecutePostLogin(event, api);
+  assert.deepEqual(calls, [['challenge', { type: 'webauthn-roaming' }],
+    ['claim', 'https://maaherlms.aimz.my.id/assurance', 'maaher-fido2-uv-v1']]);
+});
+test('unapproved subject is denied even with an enrolled key', async () => {
+  const { event, api, calls } = input(); event.user.app_metadata.maaher_staff_approved = false;
+  await onExecutePostLogin(event, api); assert.equal(calls.length, 1); assert.equal(calls[0][0], 'deny');
+});
+test('a user-editable metadata flag cannot approve staff', async () => {
+  const { event, api, calls } = input(); event.user.app_metadata = {};
+  event.user.user_metadata = { maaher_staff_approved: true };
+  await onExecutePostLogin(event, api); assert.equal(calls[0][0], 'deny');
+});
+test('email, OTP and platform factors do not replace the roaming key', async () => {
+  for (const type of ['email', 'otp', 'webauthn-platform', 'recovery-code']) {
+    const { event, api, calls } = input(); event.user.enrolledFactors = [{ type }];
+    await onExecutePostLogin(event, api); assert.equal(calls.length, 1); assert.equal(calls[0][0], 'deny');
+  }
+});
+test('another application does not receive the Maaher assurance claim', async () => {
+  const { event, api, calls } = input(); event.client.client_id = 'other-client';
+  await onExecutePostLogin(event, api); assert.deepEqual(calls, []);
+});
+test('missing policy configuration fails closed', async () => {
+  const { event, api, calls } = input(); event.secrets = {};
+  await onExecutePostLogin(event, api); assert.equal(calls[0][0], 'deny');
+});
+test('a rejected challenge does not reach claim issuance', async () => {
+  const { event, api, calls } = input(); api.authentication.challengeWith = () => { throw Error('synthetic denial'); };
+  await assert.rejects(onExecutePostLogin(event, api)); assert.deepEqual(calls, []);
+});
+test('client request data cannot supply the assurance or approval', async () => {
+  const { event, api, calls } = input(); event.user.app_metadata = {};
+  event.request = { query: { maaher_staff_approved: true, assurance: 'maaher-fido2-uv-v1' } };
+  await onExecutePostLogin(event, api); assert.equal(calls[0][0], 'deny');
+});
