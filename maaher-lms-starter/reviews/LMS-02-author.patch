+                <label>URL HTTPS {index + 1}<input value={resource.url} required type="url" maxLength={2048} onChange={event => setLesson({ ...lesson, resources: lesson.resources.map((r, i) => i === index ? { ...r, url: event.target.value } : r) })} /></label>
