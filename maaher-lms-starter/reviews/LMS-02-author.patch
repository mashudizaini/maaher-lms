+function safeHttps(value: string | undefined) {
+  if (!value || /[\s\\\u0000-\u001f]/.test(value)) return false;
+  try { const url = new URL(value); return url.protocol === 'https:' && !url.username && !url.password; } catch { return false; }
+}
